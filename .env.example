# Local app configuration
USE_IN_MEMORY_STORE=true

# Optional local MongoDB URL (kept for future integration)
MONGODB_URI=mongodb://localhost:27017/ageova_kisan_mitra

# Security & JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_me_to_something_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
# Create/Retrieve API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Weather API
# Create/Retrieve API Key from OpenWeather: https://home.openweathermap.org/
OPENWEATHER_API_KEY=your_openweather_api_key_here
